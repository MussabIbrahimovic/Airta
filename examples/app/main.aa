import "./components.aa" as components

func greeting(name)
  return "Hello, " + name
end

async func logger(req, res, next)
  print("request", req.method, req.path)
  await next()
end

async func page(req, res)
  let view = components.Layout("Airt", [ui.element("h1", {}, [ui.text(greeting(env("AIRT_NAME", "World")))]), ui.element("p", { style: { color: "#555" } }, [ui.text("Unified language for backend + UI")])])
  res.html(view)
end

async func health(req, res)
  res.json({ status: "ok", timestamp: now() })
end

async func start()
  let server = http.server()
  server.use(logger)
  server.get("/", page)
  server.get("/api/health", health)
  let port = env("AIRT_PORT", 8080)
  print("Airt server listening on", port)
  await server.listen(port)
end

async func build(outDir)
  await fs.mkdir(outDir)
  let pageNode = components.Layout("Airt Static", [ui.element("h1", {}, [ui.text("Airt Static Build")]), ui.element("p", {}, [ui.text("Generated by airt build")])])
  await fs.write_text(path.join(outDir, "index.html"), ui.renderToHtml(pageNode))
end

exports.start = start
exports.build = build
